# Copy to .env and fill in. .env is gitignored; never commit a key.
#
# Any OpenAI-compatible /chat/completions endpoint works. Examples:
#   LM Studio   LLM_BASE_URL=http://localhost:1234/v1
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1
#   vLLM        LLM_BASE_URL=http://localhost:8000/v1
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#
# A local server needs no key; a hosted one does. From inside Docker a server
# on this machine is reachable as host.docker.internal, e.g.
#   LLM_BASE_URL=http://host.docker.internal:1234/v1

LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.5-9b

# Whether to also render the JSON Schema (with its descriptions) into the
# message. Required for local constrained decoders, which compile the schema
# to a grammar and discard `description` — the model would otherwise never see
# any of the accounting guidance.
#   auto    on unless the endpoint is known to surface descriptions
#   always  belt and braces
#   never   trust response_format alone
SCHEMA_IN_PROMPT=auto

# Determinism. "The same transaction categorized differently on different days"
# is the failure that costs a triage output its audience, so the shipped
# default is temperature 0. The seed is forwarded to providers that honour it.
LLM_TEMPERATURE=0
LLM_SEED=7

# Input and output. Flags override these; these override the shipped defaults.
# The supplied material stays byte-for-byte under ai-engineer/.
TRANSACTIONS_CSV=ai-engineer/data/transactions.csv
HISTORY_JSON=ai-engineer/data/history.json
CHART_JSON=ai-engineer/data/chart-of-accounts.json
OUTPUT_PATH=results.json

# Triage policy. Above this absolute amount (NOK), anything without exact
# recurring history support is at least accountant-review.
MATERIALITY_NOK=20000

CONCURRENCY=4
MAX_REPAIR_ATTEMPTS=3
MAX_TRANSPORT_RETRIES=3
MAX_TOOL_CALLS=4
REQUEST_TIMEOUT_MS=120000
